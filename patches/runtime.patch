+
+from app.morse_native.errors import AppError
+from app.morse_native.repository import SQLiteRepository
+from app.morse_native.config_service import ConfigService
+
+ARTIFACT_SCHEMA_VERSION = 1
+ALGORITHM = "weighted_feature_offset_v1"
+FEATURE_GRID_SIZE = 2
+MIN_TRAINING_SAMPLES = 5
+MIN_GROUP_SAMPLES = 3
+
+
+@dataclass(frozen=True)
+class TrainingSample:
+    match_id: str
+    map_id: str
