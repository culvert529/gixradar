+from typing import Any, Protocol
+
+import httpx
+
+from app.morse_native.errors import AppError
+from app.morse_native.repository import SQLiteRepository
+from app.morse_native.config_service import ConfigService
+from app.morse_native.coordinates import CoordinateTransformer, Point
+
+ROUTE_STRATEGIES = {"edge", "center", "slow", "avoid_hotspots"}
+DEFAULT_GRID_SIZE = 64
+TOP_HOTSPOT_TILE_COUNT = 5
+SUPPORTED_MODEL_SCHEMA_VERSION = 1
+SUPPORTED_MODEL_ALGORITHMS = {
+    "statistical_mean_offset_v1",
+    "statistical_median_offset_v1",
+    "weighted_feature_offset_v1",
+}
+
+
+@dataclass(frozen=True)
+class PredictionInput:
+    map_id: str
+    current_phase: int
+    current_circle_center: Point
+    team_area: Point
+    route_strategy: str
