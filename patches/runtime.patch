+++ b/app/zones/backend/app/db/migrations/012_morse_native.sql
@@ -0,0 +1,32 @@
+-- Restore the original predictor's read dependency on fresh installations.
+-- Existing history, settings, legacy model tables and artifacts are retained.
+CREATE TABLE IF NOT EXISTS hotspot_tiles (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    map_id TEXT NOT NULL,
+    phase INTEGER NOT NULL CHECK (phase BETWEEN 1 AND 8),
+    grid_size INTEGER NOT NULL DEFAULT 64 CHECK (grid_size > 0),
+    tile_x INTEGER NOT NULL CHECK (tile_x >= 0),
+    tile_y INTEGER NOT NULL CHECK (tile_y >= 0),
+    density_score REAL NOT NULL DEFAULT 0 CHECK (density_score BETWEEN 0 AND 1),
+    kill_death_score REAL NOT NULL DEFAULT 0 CHECK (kill_death_score BETWEEN 0 AND 1),
+    hotspot_score REAL NOT NULL DEFAULT 0 CHECK (hotspot_score BETWEEN 0 AND 1),
+    sample_count INTEGER NOT NULL DEFAULT 0 CHECK (sample_count >= 0),
+    generated_from_model_run_id TEXT,
+    generated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    FOREIGN KEY (generated_from_model_run_id) REFERENCES model_runs (id)
+        ON UPDATE CASCADE ON DELETE SET NULL
+);
+
+-- Only source-pinned original runs are eligible for the restored predictor.
+-- A per-reader TEMP view supplies this set to the unchanged original SQL.
+CREATE TABLE IF NOT EXISTS morse_runs (
+    model_run_id TEXT PRIMARY KEY REFERENCES model_runs(id) ON DELETE CASCADE,
+    upstream_commit TEXT NOT NULL,
+    config_fingerprint TEXT NOT NULL,
+    dataset_fingerprint TEXT NOT NULL,
+    artifact_sha256 TEXT NOT NULL,
+    artifact_path TEXT NOT NULL,
+    created_at TEXT NOT NULL,
+    training_match_count INTEGER NOT NULL DEFAULT 0,
+    validation_match_count INTEGER NOT NULL DEFAULT 0
+);
diff --git a/app/zones/backend/app/db/migrations/013_model_quality.sql b/app/zones/backend/app/db/migrations/013_model_quality.sql
new file mode 100644
--- /dev/null
+++ b/app/zones/backend/app/db/migrations/013_model_quality.sql
@@ -0,0 +1,27 @@
+-- Optional held-out circle coverage. Original runs, metrics and artifact bytes
+-- remain untouched; this cache cannot participate in original model selection.
+CREATE TABLE IF NOT EXISTS morse_model_quality (
+    model_run_id TEXT NOT NULL REFERENCES model_runs(id) ON DELETE CASCADE,
+    policy TEXT NOT NULL,
+    map_id TEXT NOT NULL,
+    upstream_commit TEXT NOT NULL,
+    config_fingerprint TEXT NOT NULL,
+    dataset_fingerprint TEXT NOT NULL,
+    artifact_sha256 TEXT NOT NULL,
+    evaluation_fingerprint TEXT,
+    effective_training_matches INTEGER NOT NULL CHECK(effective_training_matches >= 0),
+    validation_match_count INTEGER NOT NULL CHECK(validation_match_count >= 0),
+    validation_case_count INTEGER NOT NULL CHECK(validation_case_count >= 0),
+    hit_count INTEGER NOT NULL CHECK(hit_count >= 0 AND hit_count <= validation_case_count),
+    unscored_case_count INTEGER NOT NULL CHECK(unscored_case_count >= 0),
+    expected_case_count INTEGER NOT NULL CHECK(expected_case_count = validation_case_count + unscored_case_count),
+    confidence_percent REAL,
+    quality_state TEXT NOT NULL CHECK(quality_state IN ('ready','insufficient_validation','pending','unavailable')),
+    trained_at TEXT NOT NULL,
+    evaluated_at TEXT NOT NULL,
+    PRIMARY KEY(model_run_id, policy),
+    CHECK ((quality_state = 'ready' AND validation_match_count >= 5
+            AND validation_case_count > 0 AND unscored_case_count = 0
+            AND confidence_percent IS NOT NULL AND confidence_percent BETWEEN 0 AND 100)
+        OR (quality_state != 'ready' AND confidence_percent IS NULL))
+);
