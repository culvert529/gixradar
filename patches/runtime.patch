@@ -0,0 +1,680 @@
+"""Optional historical coverage of the latest original training artifact.
+
+This is pooled held-out case coverage, not a future-circle probability. Native
+fit, split, artifact bytes, circle math and serving model ranking are unchanged.
+Evaluation is a writer task; status reads only the saved per-run cache.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict
+from datetime import datetime, timezone
+from math import hypot, isclose, isfinite
+from pathlib import Path
+from statistics import median
+from uuid import uuid4
+import hashlib
+import json
+import re
+import sqlite3
+
+from app.morse_native.coordinates import CoordinateTransformer, Point
+from app.morse_native.prediction import PredictionService as NativePredictionService, LLMSettings
+from app.morse_native.training import TrainingService as NativeTrainingService, TrainingSample
+from app.morse_native.errors import AppError as NativeError
+from app.services.analyzer import (ALGORITHM, UPSTREAM_COMMIT, artifact_reference, fingerprint,
+    native_config, canonical_mode, radius_profiles, VerifiedPredictionService)
+
+POLICY = 'native-heldout-containment-v1'
+MIN_VALIDATION_MATCHES = 5
+_COLUMNS = ('model_run_id','policy','map_id','upstream_commit','config_fingerprint','dataset_fingerprint',
+    'artifact_sha256','evaluation_fingerprint','effective_training_matches','validation_match_count',
+    'validation_case_count','hit_count','unscored_case_count','expected_case_count','confidence_percent',
+    'quality_state','trained_at','evaluated_at')
+_RUNS_SQL = """SELECT r.id,r.created_at,r.maps_included,r.sample_count,r.model_path,r.status,r.algorithm,
+    p.upstream_commit,p.config_fingerprint,p.dataset_fingerprint,p.artifact_sha256,
+    p.training_match_count,p.validation_match_count
+    FROM main.model_runs r JOIN main.morse_runs p ON p.model_run_id=r.id
+    WHERE r.status='completed' AND p.upstream_commit=? AND r.algorithm=?"""
+
+
+def _check(cancel_check):
+    if cancel_check is not None:
+        cancel_check()
+
+
+def _count(value):
+    return type(value) is int and value >= 0
+
+
+def _finite(value):
+    return type(value) in (int, float) and isfinite(value)
+
+
+def _map_id(row, known):
+    try:
+        maps = json.loads(row['maps_included'])
+    except (ValueError, TypeError):
+        return None
+    # Application-owned native runs train exactly one map. A multi-map run's
+    # aggregate training count cannot honestly be attributed to each map.
+    return maps[0] if isinstance(maps,list) and len(maps)==1 and isinstance(maps[0],str) and maps[0] in known else None
+
+
+def _base(row, map_id):
+    return {'map_id':map_id,'model_run_id':row['id'],
+        'effective_training_matches':row['training_match_count'],'confidence_percent':None,
+        'validation_match_count':row['validation_match_count'],'validation_case_count':0,'hit_count':0,
+        'quality_state':'pending','trained_at':row['created_at'],'policy':POLICY}
+
+
+def _cached(connection, row, map_id):
+    try:
+        cached = connection.execute('SELECT * FROM main.morse_model_quality WHERE model_run_id=? AND policy=?',
+                                    (row['id'],POLICY)).fetchone()
+    except sqlite3.Error:
+        return None
+    if cached is None:
+        return None
+    if any(cached[key] != row[key] for key in ('upstream_commit','config_fingerprint','dataset_fingerprint','artifact_sha256')):
+        return None
+    if (cached['map_id'] != map_id or cached['effective_training_matches'] != row['training_match_count']
+            or cached['validation_match_count'] != row['validation_match_count'] or cached['trained_at'] != row['created_at']):
+        return None
+    counts = [cached[key] for key in ('effective_training_matches','validation_match_count',
+        'validation_case_count','hit_count','unscored_case_count','expected_case_count')]
+    if not all(_count(value) for value in counts):
+        return None
+    cases, hits, missing, expected = counts[2:]
+    state, score = cached['quality_state'], cached['confidence_percent']
+    if hits > cases or cases + missing != expected or state not in ('ready','insufficient_validation','pending','unavailable'):
+        return None
+    if state == 'ready':
+        if (counts[1] < MIN_VALIDATION_MATCHES or cases == 0 or missing or not _finite(score)
+                or expected < 2*counts[1] or not 0 <= score <= 100
+                or not isclose(float(score),100.0*hits/cases,rel_tol=0,abs_tol=1e-9)):
+            return None
+    elif score is not None:
+        return None
+    if state == 'insufficient_validation' and counts[1] >= MIN_VALIDATION_MATCHES:
+        return None
+    if state != 'pending' and (not isinstance(cached['evaluation_fingerprint'],str)
+                              or not re.fullmatch('[a-f0-9]{64}',cached['evaluation_fingerprint'])):
+        return None
+    return cached
+
+
+def _public(cached, row, map_id):
+    result = _base(row,map_id)
+    for key in ('confidence_percent','validation_case_count','hit_count','quality_state'):
+        result[key] = cached[key]
+    return result
+
+
+def _radii(connection, ids, cancel_check):
+    result = {}
+    # Keep below older SQLite variable limits even after long-lived collection.
+    ordered = sorted(ids)
+    for offset in range(0,len(ordered),500):
+        _check(cancel_check)
+        batch = ordered[offset:offset+500]
+        rows = connection.execute('SELECT match_id,phase,radius FROM main.circle_phases WHERE match_id IN ('+
+                                  ','.join('?' for _ in batch)+') ORDER BY match_id,phase',batch).fetchall()
+        for row in rows:
+            if _finite(row['radius']) and row['radius'] >= 0:
+                result[(row['match_id'],row['phase'])] = float(row['radius'])
+    return result
+
+
+def _save(connection, values):
+    columns = ','.join(_COLUMNS)
+    updates = ','.join(name+'=excluded.'+name for name in _COLUMNS if name not in ('model_run_id','policy'))
+    connection.execute('INSERT INTO main.morse_model_quality('+columns+') VALUES('+','.join('?' for _ in _COLUMNS)+
+        ') ON CONFLICT(model_run_id,policy) DO UPDATE SET '+updates,tuple(values[name] for name in _COLUMNS))
+
+
+def _ensure_latest_training_quality(connection, config, model_dir, run_id, cancel_check=None):
+    """Evaluate one exact original run inside the caller's existing transaction.
+
+    No commit or DDL is issued. This function rolls back only its own SAVEPOINT
+    on error and re-raises, allowing integration to keep optional quality failure
+    separate from successful original training. Cancellation is never swallowed.
+    """
+    if not connection.in_transaction:
+        raise ValueError('Quality evaluation requires a caller-owned transaction')
+    _check(cancel_check)
+    marker = 'morse_quality_'+uuid4().hex
+    connection.execute('SAVEPOINT '+marker)
+    try:
+        native = native_config()
+        known = {entry['map_id'] for entry in native.list_maps()}
+        row = connection.execute(_RUNS_SQL+' AND r.id=?',(UPSTREAM_COMMIT,ALGORITHM,run_id)).fetchone()
+        if row is None or not all(_count(row[key]) for key in ('sample_count','training_match_count','validation_match_count')):
+            _check(cancel_check)
+            connection.execute('RELEASE SAVEPOINT '+marker)
+            return None
+        map_id = _map_id(row,known)
+        reference = artifact_reference(connection,model_dir,run_id) if map_id else None
+        if reference is None:
+            _check(cancel_check)
+            connection.execute('RELEASE SAVEPOINT '+marker)
+            return None
+        _registered, artifact, _payload = reference
+        values = {'model_run_id':run_id,'policy':POLICY,'map_id':map_id,
+            **{key:row[key] for key in ('upstream_commit','config_fingerprint','dataset_fingerprint','artifact_sha256')},
+            'evaluation_fingerprint':None,'effective_training_matches':row['training_match_count'],
+            'validation_match_count':row['validation_match_count'],'validation_case_count':0,'hit_count':0,
+            'unscored_case_count':0,'expected_case_count':0,'confidence_percent':None,'quality_state':'pending',
+            'trained_at':row['created_at'],'evaluated_at':datetime.now(timezone.utc).isoformat()}
+        entry = native.get_map(map_id)
+        phases = native.get_zone_phases(map_id)
+        trainer = NativeTrainingService(connection,native,Path(model_dir)/'morse')
+        samples = trainer.build_samples(map_id)
+        _check(cancel_check)
+        current_config = fingerprint({'map':entry,'zones':phases})
+        current_dataset = fingerprint({'map_id':map_id,'samples':[asdict(sample) for sample in samples]})
+        training, validation = trainer._split_samples_by_match(samples)
+        train_ids = {sample.match_id for sample in training}
+        validation_ids = {sample.match_id for sample in validation}
+        same = (current_config == row['config_fingerprint'] and current_dataset == row['dataset_fingerprint']
+            and len(samples) == row['sample_count'] and len(train_ids) == row['training_match_count']
+            and len(validation_ids) == row['validation_match_count'])
+        if same:
+            training_radii = _radii(connection,train_ids,cancel_check)
+            # Only training-game target radii calibrate the predicted circle.
+            medians = {phase:float(median([radius for (_identity,p),radius in training_radii.items() if p==phase]))
+                       for phase in sorted({p for _identity,p in training_radii})}
+            known_radii = {}
+            for sample in validation:
+                _check(cancel_check)
+                radius = connection.execute('SELECT radius FROM main.circle_phases WHERE match_id=? AND phase=?',
+                                            (sample.match_id,sample.current_phase)).fetchone()
+                value = radius['radius'] if radius is not None else None
+                known_radii[(sample.match_id,sample.current_phase)] = float(value) if _finite(value) and value>0 else None
+            values['evaluation_fingerprint'] = fingerprint({'training_target_radii':sorted(medians.items()),
+                'validation_known_current_radii':[[sample.match_id,sample.current_phase,known_radii[(sample.match_id,sample.current_phase)]] for sample in validation]})
+            cached = _cached(connection,row,map_id)
+            if cached is not None and cached['evaluation_fingerprint'] == values['evaluation_fingerprint']:
+                _check(cancel_check)
+                connection.execute('RELEASE SAVEPOINT '+marker)
+                return _public(cached,row,map_id)
+            predictor = NativePredictionService(connection,native,Path(model_dir)/'morse',
+                LLMSettings(enabled=False,base_url=None,api_key=None,model=None,timeout_seconds=1))
+            loaded = predictor._load_model_from_row(row,[])
+            values['expected_case_count'] = 2*len(validation)
+            if loaded is None:
+                values['unscored_case_count'] = values['expected_case_count']
+                values['quality_state'] = 'unavailable'
+            else:
+                transformer = CoordinateTransformer.from_map_config(entry)
+                final_phase = int(phases['final_phase'])
+                for sample in validation:
+                    _check(cancel_check)
+                    current_radius = known_radii[(sample.match_id,sample.current_phase)]
+                    current = Point(sample.current_center_x,sample.current_center_y)
+                    targets = trainer._sample_targets(sample)
+                    if not all(_finite(value) for value in (current.x,current.y)):
+                        values['unscored_case_count'] += 2
+                        continue
+                    try:
+                        predictor._validate_world_point(transformer,current)
+                    except NativeError:
+                        values['unscored_case_count'] += 2
+                        continue
+                    for kind,target_phase,shift in (('next',sample.current_phase+1,0.25),('final',final_phase,0.6)):
+                        _check(cancel_check)
+                        target = targets[kind]
+                        radius = medians.get(target_phase)
+                        if (current_radius is None or radius is None or not all(_finite(value) for value in
+                                (current.x,current.y,target.x,target.y))):
+                            values['unscored_case_count'] += 1
+                            continue
+                        # These are the unchanged pinned predict() call arguments;
+                        # no offset, feature-grid, constraint or fallback formula
+                        # is copied here. Validation targets are used only below.
+                        circle = predictor._predict_circle(map_id=map_id,current_phase=sample.current_phase,
+                            target_type=kind,target_phase=target_phase,current_radius=current_radius,target_radius=radius,
+                            current_center=current,transformer=transformer,loaded_model=loaded,fallback_shift=shift,warnings=[])
+                        if (not all(_finite(value) for value in (circle.center.x,circle.center.y,circle.radius)) or circle.radius<0):
+                            values['unscored_case_count'] += 1
+                            continue
+                        values['validation_case_count'] += 1
+                        if hypot(circle.center.x-target.x,circle.center.y-target.y) <= circle.radius:
+                            values['hit_count'] += 1
+                if len(validation_ids) < MIN_VALIDATION_MATCHES:
+                    values['quality_state'] = 'insufficient_validation'
+                elif not values['validation_case_count'] or values['unscored_case_count']:
+                    values['quality_state'] = 'unavailable'
+                else:
+                    values['quality_state'] = 'ready'
+                    values['confidence_percent'] = 100.0*values['hit_count']/values['validation_case_count']
+            # Loading/evaluation never edits the original JSON; reject any
+            # outside mutation while the optional calculation was in flight.
+            if hashlib.sha256(artifact.read_bytes()).hexdigest() != row['artifact_sha256']:
+                raise ValueError('Native artifact changed during quality evaluation')
+        _check(cancel_check)
+        _save(connection,values)
+        _check(cancel_check)
+        connection.execute('RELEASE SAVEPOINT '+marker)
+        return _public(values,row,map_id)
+    except BaseException:
+        # SQLite may already have cancelled its outer transaction after an I/O
+        # failure. Cleanup must never replace the original error/Cancelled.
+        try:
+            connection.execute('ROLLBACK TO SAVEPOINT '+marker)
+            connection.execute('RELEASE SAVEPOINT '+marker)
+        except sqlite3.Error:
+            pass
+        raise
+
+
+def latest_training_maps(connection, config, model_dir):
+    """Latest completed valid native run per map; cached quality only, no fit."""
+    native = native_config()
+    known = {entry['map_id'] for entry in native.list_maps()}
+    result = {map_id:{'map_id':map_id,'model_run_id':None,'effective_training_matches':0,
+        'confidence_percent':None,'validation_match_count':0,'validation_case_count':0,'hit_count':0,
+        'quality_state':'pending','trained_at':None,'policy':POLICY} for map_id in known}
+    try:
+        rows = connection.execute(_RUNS_SQL+' ORDER BY r.created_at DESC,r.id DESC',(UPSTREAM_COMMIT,ALGORITHM)).fetchall()
+        found = set()
+        for row in rows:
+            map_id = _map_id(row,known)
+            if map_id is None or map_id in found or not all(_count(row[key]) for key in ('training_match_count','validation_match_count')):
+                continue
+            if artifact_reference(connection,model_dir,row['id']) is None:
+                result[map_id]['quality_state'] = 'unavailable'
+                continue
+            found.add(map_id)
+            result[map_id] = _base(row,map_id)
+            cached = _cached(connection,row,map_id)
+            if cached is not None:
+                result[map_id] = _public(cached,row,map_id)
+    except (sqlite3.Error, OSError, ValueError, TypeError):
+        # Optional metadata failure must not break the existing collector GET.
+        pass
+    for entry in native.list_maps():
+        result[entry['map_id']]['modes'] = _read_serving_modes(connection,model_dir,entry['map_id'])
+        from app.services.prequential import rolling_quality
+        for mode,value in result[entry['map_id']]['modes'].items():
+            value['rolling'] = rolling_quality(connection,entry['map_id'],mode)
+    return [result[entry['map_id']] for entry in native.list_maps()]
+
+
+SERVING_POLICY = 'native-serving-mode-v2'
+MANIFEST_POLICY = 'native-source-manifest-v1'
+_MODES = ('normal','competitive')
+_HORIZONS = ('next','final')
+
+
+def _time(value):
+    """Recorded UTC instants only; never infer independence from naive dates."""
+    if not isinstance(value,str):
+        return None
+    try:
+        parsed = datetime.fromisoformat(value.replace('Z','+00:00'))
+        return parsed.astimezone(timezone.utc) if parsed.tzinfo is not None else None
+    except (ValueError,OverflowError):
+        return None
+
+
+def _json(value):
+    return json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)
+
+
+def _horizon(state='pending', games=0):
+    return {'quality_state':state,'validation_match_count':games,'case_count':0,'hit_count':0,
+        'prediction_case_count':0,'unavailable_case_count':0,'confidence_percent':None,
+        'interval95_lower_percent':None,'interval95_upper_percent':None}
+
+
+def _mode_base(map_id, mode, row=None, reason='no_model'):
+    return {'policy':SERVING_POLICY,'map_id':map_id,'match_type':mode,
+        'model_run_id':row['id'] if row is not None else None,'training_scope':'mixed',
+        'shared_training_matches':row['training_match_count'] if row is not None else 0,
+        'latest_model_run_id':None,'latest_effective_training_matches':0,
+        'effective_training_matches':None,'validation_match_count':0,
+        'evaluation_kind':'unavailable','quality_state':'pending' if row is not None else 'unavailable',
+        'unavailable_reason':reason,'next':_horizon('pending' if row is not None else 'unavailable'),
+        'final':_horizon('pending' if row is not None else 'unavailable')}
+
+
+def _verified_service(connection,model_dir):
+    # Do not install a TEMP model_runs view on a writer connection. The verified
+    # loader skips every unregistered artifact, preserving the native rank SQL.
+    return VerifiedPredictionService(connection,native_config(),Path(model_dir)/'morse',
+        LLMSettings(enabled=False,base_url=None,api_key=None,model=None,timeout_seconds=1))
+
+
+def _served_row(connection,model_dir,map_id):
+    loaded = _verified_service(connection,model_dir)._load_latest_model(map_id,[])
+    if loaded is None:
+        return None
+    return connection.execute(_RUNS_SQL+' AND r.id=?',
+        (UPSTREAM_COMMIT,ALGORITHM,loaded.run_id)).fetchone()
+
+
+def _metadata(connection,ids):
+    result = {}
+    ordered = sorted(ids)
+    for offset in range(0,len(ordered),500):
+        batch = ordered[offset:offset+500]
+        for row in connection.execute('SELECT match_id,match_type,created_at FROM main.matches WHERE match_id IN ('+
+                ','.join('?' for _ in batch)+')',batch):
+            result[row['match_id']] = {'mode':canonical_mode(row['match_type']),
+                'created_at':row['created_at'] if _time(row['created_at']) is not None else None}
+    return result
+
+
+def _saved_manifest(connection,row,map_id,trainer):
+    saved = connection.execute('SELECT * FROM main.morse_training_manifests WHERE model_run_id=?',
+                               (row['id'],)).fetchone()
+    keys = ('upstream_commit','config_fingerprint','dataset_fingerprint','artifact_sha256')
+    if saved is not None and saved['policy']==MANIFEST_POLICY and all(saved[key]==row[key] for key in keys):
+        try:
+            payload = json.loads(saved['payload_json'])
+            restored = [TrainingSample(**value) for value in payload['samples']]
+            train,val = trainer._split_samples_by_match(restored)
+            if (fingerprint(payload)==saved['payload_sha256']
+                    and fingerprint({'map_id':map_id,'samples':[asdict(value) for value in restored]})==row['dataset_fingerprint']
+                    and len(restored)==row['sample_count'] and len({value.match_id for value in train})==row['training_match_count']
+                    and len({value.match_id for value in val})==row['validation_match_count']):
+                return payload,restored,train,val
+        except (ValueError,TypeError,KeyError):
+            pass
+    return None
+
+
+def _manifest(connection,row,map_id,trainer,samples,check):
+    """Read or capture only a dataset whose exact original fingerprint matches."""
+    existing = _saved_manifest(connection,row,map_id,trainer)
+    if existing is not None:
+        return existing
+    keys = ('upstream_commit','config_fingerprint','dataset_fingerprint','artifact_sha256')
+    native = native_config()
+    if fingerprint({'map':native.get_map(map_id),'zones':native.get_zone_phases(map_id)}) != row['config_fingerprint']:
+        return None
+    all_ids = {value.match_id for value in samples}
+    metadata = _metadata(connection,all_ids)
+    cutoff = _time(row['created_at'])
+    candidates = [samples,samples[:row['sample_count']]]
+    # Insertion order is only a reconstruction candidate, never evidence by
+    # itself. Every recovered population must still match the original exact
+    # sample/config fingerprints and whole-match split counts below.
+    earliest = connection.execute('SELECT match_id,MIN(rowid) AS earliest FROM main.circle_phases '+
+                                  'GROUP BY match_id ORDER BY earliest,match_id').fetchall()
+    required_matches = row['training_match_count']+row['validation_match_count']
+    ordered_ids = [value['match_id'] for value in earliest if value['match_id'] in all_ids][:required_matches]
+    chosen = set(ordered_ids)
+    candidates.append([value for value in samples if value.match_id in chosen])
+    if cutoff is not None:
+        candidates.append([value for value in samples if _time(metadata.get(value.match_id,{}).get('created_at')) is not None
+                           and _time(metadata[value.match_id]['created_at'])<=cutoff])
+    for candidate in candidates:
+        _check(check)
+        if len(candidate)!=row['sample_count']:
+            continue
+        if fingerprint({'map_id':map_id,'samples':[asdict(value) for value in candidate]}) != row['dataset_fingerprint']:
+            continue
+        train,val = trainer._split_samples_by_match(candidate)
+        train_ids,val_ids = {value.match_id for value in train},{value.match_id for value in val}
+        if len(train_ids)!=row['training_match_count'] or len(val_ids)!=row['validation_match_count']:
+            continue
+        radii = _radii(connection,train_ids,check)
+        val_radii = []
+        for value in val:
+            radius = connection.execute('SELECT radius FROM main.circle_phases WHERE match_id=? AND phase=?',
+                                        (value.match_id,value.current_phase)).fetchone()
+            current = radius[0] if radius is not None else None
+            val_radii.append([value.match_id,value.current_phase,current if _finite(current) and current>0 else None])
+        payload = {'version':1,'samples':[asdict(value) for value in candidate],
+            'matches':{identity:metadata.get(identity,{'mode':None,'created_at':None}) for identity in sorted(train_ids|val_ids)},
+            'training_radii':[[identity,phase,radius] for (identity,phase),radius in sorted(radii.items())],
+            'validation_known_radii':val_radii}
+        connection.execute('INSERT INTO main.morse_training_manifests(model_run_id,policy,upstream_commit,config_fingerprint,'+
+            'dataset_fingerprint,artifact_sha256,payload_sha256,payload_json,created_at) VALUES(?,?,?,?,?,?,?,?,?) '+
+            'ON CONFLICT(model_run_id) DO UPDATE SET policy=excluded.policy,upstream_commit=excluded.upstream_commit,'+
+            'config_fingerprint=excluded.config_fingerprint,dataset_fingerprint=excluded.dataset_fingerprint,'+
+            'artifact_sha256=excluded.artifact_sha256,payload_sha256=excluded.payload_sha256,payload_json=excluded.payload_json',
+            (row['id'],MANIFEST_POLICY,*(row[key] for key in keys),fingerprint(payload),_json(payload),
+             datetime.now(timezone.utc).isoformat()))
+        return payload,candidate,train,val
+    return None
+
+
+def _mode_profiles(radii,metadata,mode):
+    observations = {}
+    for identity,phase,radius in radii:
+        if metadata.get(identity,{}).get('mode')==mode and _finite(radius) and radius>0:
+            observations.setdefault(str(phase),[]).append((identity,float(radius)))
+    return radius_profiles(observations)
+
+
+def _population(connection,row,map_id,mode,manifest,trainer,samples,check):
+    names = native_config().get_map(map_id)['telemetry_names']
+    all_ids = {value[0] for value in connection.execute('SELECT match_id FROM main.matches WHERE map_name IN ('+
+        ','.join('?' for _ in names)+')',names)}
+    metadata = _metadata(connection,all_ids)
+    cutoff = _time(row['created_at'])
+    known = {value.match_id for value in manifest[1]} if manifest else set()
+    post_ids = {identity for identity,item in metadata.items() if item['mode']==mode and cutoff is not None
+        and _time(item['created_at']) is not None and _time(item['created_at'])>cutoff and identity not in known}
+    holdout = []
+    if manifest:
+        payload,source,train,val = manifest
+        holdout = [value for value in val if payload['matches'].get(value.match_id,{}).get('mode')==mode]
+    # Later official match creation instants provide an independent continuing
+    # population; no ingestion-time or lexicographic guess establishes holdout.
+    if len(post_ids)>=MIN_VALIDATION_MATCHES or not holdout:
+        population = [value for value in samples if value.match_id in post_ids]
+        before_ids = {identity for identity,item in metadata.items() if item['mode']==mode and cutoff is not None
+            and _time(item['created_at']) is not None and _time(item['created_at'])<cutoff and identity not in post_ids}
+        radii = [[identity,phase,radius] for (identity,phase),radius in _radii(connection,before_ids,check).items()]
+        known_radii = {}
+        for value in population:
+            current = connection.execute('SELECT radius FROM main.circle_phases WHERE match_id=? AND phase=?',
+                                         (value.match_id,value.current_phase)).fetchone()
+            radius = current[0] if current is not None else None
+            known_radii[(value.match_id,value.current_phase)] = radius if _finite(radius) and radius>0 else None
+        return 'post_training',population,_mode_profiles(radii,metadata,mode),known_radii
+    payload,source,train,val = manifest
+    radii = payload['training_radii']
+    known_radii = {(identity,phase):radius for identity,phase,radius in payload['validation_known_radii']}
+    return 'native_holdout',holdout,_mode_profiles(radii,payload['matches'],mode),known_radii
+
+
+def _evaluate_mode(connection,row,map_id,mode,manifest,trainer,samples,model_dir,check):
+    from app.services.prediction import PredictionService as RadarPrediction,RadarCircleConfig,stage_candidate
+    result = _mode_base(map_id,mode,row,'no_independent_population')
+    if manifest:
+        payload,source,train,val = manifest
+        result['effective_training_matches'] = len({value.match_id for value in train
+            if payload['matches'].get(value.match_id,{}).get('mode')==mode})
+    kind,population,profiles,known_radii = _population(connection,row,map_id,mode,manifest,trainer,samples,check)
+    identities = {value.match_id for value in population}
+    result.update(evaluation_kind=kind,validation_match_count=len(identities))
+    result['parameter_scope'] = 'frozen_training_or_pre_run_history_with_native_defaults'
+    warnings = []
+    radii = RadarPrediction._configured_radii({mode:profiles},warnings)
+    predictor = _verified_service(connection,model_dir)
+    loaded = predictor._load_model_from_row(row,[])
+    transformer = CoordinateTransformer.from_map_config(native_config().get_map(map_id))
+    horizons = {name:_horizon(games=len(identities)) for name in _HORIZONS}
+    for sample in population:
+        _check(check)
+        current_radius = known_radii.get((sample.match_id,sample.current_phase))
+        inferred = stage_candidate(profiles,current_radius) if current_radius is not None else None
+        phase = inferred[0] if inferred is not None else None
+        configured = {}
+        if phase is not None:
+            frozen = dict(radii)
+            frozen[phase] = current_radius
+            configured = {value['phase']:value['radius'] for value in
+                RadarCircleConfig(native_config(),map_id,frozen).get_zone_phases(map_id)['phases']}
+        eligible = (loaded is not None and phase is not None and phase<8
+            and all(target in configured and 0<configured[target]<current_radius for target in (phase+1,8)))
+        targets = trainer._sample_targets(sample)
+        current = Point(sample.current_center_x,sample.current_center_y)
+        try:
+            predictor._validate_world_point(transformer,current)
+        except NativeError:
+            eligible = False
+        for kind,shift in (('next',.25),('final',.6)):
+            metric = horizons[kind]
+            metric['case_count'] += 1
+            target = targets[kind]
+            if not eligible or not all(_finite(value) for value in (target.x,target.y)):
+                metric['unavailable_case_count'] += 1
+                continue
+            target_phase = phase+1 if kind=='next' else 8
+            circle = predictor._predict_circle(map_id=map_id,current_phase=phase,target_type=kind,
+                target_phase=target_phase,current_radius=current_radius,target_radius=configured[target_phase],
+                current_center=current,transformer=transformer,loaded_model=loaded,fallback_shift=shift,warnings=[])
+            if not all(_finite(value) for value in (circle.center.x,circle.center.y,circle.radius)) or circle.radius<=0:
+                metric['unavailable_case_count'] += 1
+                continue
+            metric['prediction_case_count'] += 1
+            actual_phase = sample.current_phase+1 if kind=='next' else 8
+            if circle.phase==actual_phase and hypot(circle.center.x-target.x,circle.center.y-target.y)<=circle.radius:
+                metric['hit_count'] += 1
+    for metric in horizons.values():
+        if len(identities)<MIN_VALIDATION_MATCHES:
+            metric['quality_state'] = 'insufficient_validation'
+        elif not metric['prediction_case_count']:
+            metric['quality_state'] = 'unavailable'
+        else:
+            metric['quality_state'] = 'ready'
+            metric['confidence_percent'] = 100.0*metric['hit_count']/metric['case_count']
+    result.update(horizons)
+    states = {metric['quality_state'] for metric in horizons.values()}
+    result['quality_state'] = 'ready' if states=={'ready'} else ('insufficient_validation' if 'insufficient_validation' in states else 'unavailable')
+    result['unavailable_reason'] = None if result['quality_state']=='ready' else (
+        'insufficient_independent_matches' if len(identities)<MIN_VALIDATION_MATCHES else 'uncalibrated_inputs')
+    evidence = {'kind':kind,'samples':[asdict(value) for value in population],
+        'known_current_radii':[[value.match_id,value.current_phase,known_radii.get((value.match_id,value.current_phase))] for value in population],
+        'calibration_profiles':profiles,'manifest_sha256':fingerprint(manifest[0]) if manifest else None}
+    return result,fingerprint(evidence)
+
+
+def _refresh_serving_quality(connection,model_dir,map_id,check):
+    row = _served_row(connection,model_dir,map_id)
+    if row is None:
+        return
+    trainer = NativeTrainingService(connection,native_config(),Path(model_dir)/'morse')
+    samples = trainer.build_samples(map_id)
+    manifest = _manifest(connection,row,map_id,trainer,samples,check)
+    for mode in _MODES:
+        result,evidence = _evaluate_mode(connection,row,map_id,mode,manifest,trainer,samples,model_dir,check)
+        _check(check)
+        keys = ('upstream_commit','config_fingerprint','dataset_fingerprint','artifact_sha256')
+        connection.execute('INSERT INTO main.morse_serving_quality(model_run_id,match_type,policy,upstream_commit,'+
+            'config_fingerprint,dataset_fingerprint,artifact_sha256,evaluation_fingerprint,payload_sha256,payload_json,evaluated_at) '+
+            'VALUES(?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(model_run_id,match_type,policy) DO UPDATE SET '+
+            'upstream_commit=excluded.upstream_commit,config_fingerprint=excluded.config_fingerprint,'+
+            'dataset_fingerprint=excluded.dataset_fingerprint,artifact_sha256=excluded.artifact_sha256,'+
+            'evaluation_fingerprint=excluded.evaluation_fingerprint,payload_sha256=excluded.payload_sha256,'+
+            'payload_json=excluded.payload_json,evaluated_at=excluded.evaluated_at',
+            (row['id'],mode,SERVING_POLICY,*(row[key] for key in keys),evidence,fingerprint(result),_json(result),
+             datetime.now(timezone.utc).isoformat()))
+
+
+def ensure_training_quality(connection,config,model_dir,run_id,cancel_check=None):
+    """Compatible latest cache plus exact currently served per-mode evaluation."""
+    if not connection.in_transaction:
+        raise ValueError('Quality evaluation requires a caller-owned transaction')
+    marker = 'serving_quality_'+uuid4().hex
+    connection.execute('SAVEPOINT '+marker)
+    try:
+        legacy = _ensure_latest_training_quality(connection,config,model_dir,run_id,cancel_check)
+        row = connection.execute(_RUNS_SQL+' AND r.id=?',(UPSTREAM_COMMIT,ALGORITHM,run_id)).fetchone()
+        if row is not None and artifact_reference(connection,model_dir,run_id) is not None:
+            map_id = _map_id(row,{entry['map_id'] for entry in native_config().list_maps()})
+            if map_id is not None:
+                trainer = NativeTrainingService(connection,native_config(),Path(model_dir)/'morse')
+                _manifest(connection,row,map_id,trainer,trainer.build_samples(map_id),cancel_check)
+                _refresh_serving_quality(connection,model_dir,map_id,cancel_check)
+        _check(cancel_check)
+        connection.execute('RELEASE SAVEPOINT '+marker)
+        return legacy
+    except BaseException:
+        try:
+            connection.execute('ROLLBACK TO SAVEPOINT '+marker)
+            connection.execute('RELEASE SAVEPOINT '+marker)
+        except sqlite3.Error:
+            pass
+        raise
+
+
+def _valid_mode(payload,row,map_id,mode):
+    if (not isinstance(payload,dict) or payload.get('policy')!=SERVING_POLICY or payload.get('map_id')!=map_id
+            or payload.get('match_type')!=mode or payload.get('model_run_id')!=row['id']
+            or payload.get('training_scope')!='mixed' or payload.get('shared_training_matches')!=row['training_match_count']
+            or payload.get('evaluation_kind') not in ('native_holdout','post_training','unavailable')):
+        return False
+    count = payload.get('effective_training_matches')
+    if count is not None and (not _count(count) or count>row['training_match_count']):
+        return False
+    if (not _count(payload.get('validation_match_count')) or payload.get('quality_state') not in
+            ('ready','pending','unavailable','insufficient_validation')):
+        return False
+    for name in _HORIZONS:
+        metric = payload.get(name)
+        if not isinstance(metric,dict):
+            return False
+        values = [metric.get(key) for key in ('validation_match_count','case_count','hit_count','prediction_case_count','unavailable_case_count')]
+        if not all(_count(value) for value in values):
+            return False
+        games,cases,hits,predicted,missing = values
+        if hits>predicted or predicted+missing!=cases or games>cases or games!=payload['validation_match_count']:
+            return False
+        state,percent = metric.get('quality_state'),metric.get('confidence_percent')
+        if state=='ready':
+            if games<5 or not predicted or not _finite(percent) or not 0<=percent<=100 or not isclose(percent,100*hits/cases,abs_tol=1e-9):
+                return False
+        elif state not in ('pending','unavailable','insufficient_validation') or percent is not None:
+            return False
+        if state=='insufficient_validation' and games>=5:
+            return False
+        if metric.get('interval95_lower_percent') is not None or metric.get('interval95_upper_percent') is not None:
+            return False
+    states = {payload[name]['quality_state'] for name in _HORIZONS}
+    expected = 'ready' if states=={'ready'} else ('insufficient_validation' if 'insufficient_validation' in states else 'unavailable')
+    if payload['quality_state']!=expected:
+        return False
+    return True
+
+
+def _read_serving_modes(connection,model_dir,map_id):
+    row = None
+    try:
+        row = _served_row(connection,model_dir,map_id)
+        result = {mode:_mode_base(map_id,mode,row,'evaluation_pending' if row is not None else 'no_model') for mode in _MODES}
+        if row is None:
+            return result
+        for mode in _MODES:
+            cached = connection.execute('SELECT * FROM main.morse_serving_quality WHERE model_run_id=? AND match_type=? AND policy=?',
+                                        (row['id'],mode,SERVING_POLICY)).fetchone()
+            if cached is None or any(cached[key]!=row[key] for key in ('upstream_commit','config_fingerprint','dataset_fingerprint','artifact_sha256')):
+                continue
+            try:
+                payload = json.loads(cached['payload_json'])
+                if fingerprint(payload)==cached['payload_sha256'] and _valid_mode(payload,row,map_id,mode):
+                    result[mode] = payload
+            except (ValueError,TypeError,KeyError):
+                pass
+        latest_rows = connection.execute(_RUNS_SQL+' ORDER BY r.created_at DESC,r.id DESC',
+                                         (UPSTREAM_COMMIT,ALGORITHM)).fetchall()
+        for latest in latest_rows:
+            if _map_id(latest,{map_id})!=map_id or artifact_reference(connection,model_dir,latest['id']) is None:
+                continue
+            trainer = NativeTrainingService(connection,native_config(),Path(model_dir)/'morse')
+            manifest = _saved_manifest(connection,latest,map_id,trainer)
+            for mode in _MODES:
+                result[mode]['latest_model_run_id'] = latest['id']
+                result[mode]['latest_effective_training_matches'] = None
+                if manifest is not None:
+                    result[mode]['latest_effective_training_matches'] = len({value.match_id for value in manifest[2]
+                        if manifest[0]['matches'].get(value.match_id,{}).get('mode')==mode})
+            break
+        return result
+    except (sqlite3.Error,OSError,ValueError,TypeError,KeyError):
+        return {mode:_mode_base(map_id,mode,row,'evaluation_pending' if row is not None else 'no_model') for mode in _MODES}
