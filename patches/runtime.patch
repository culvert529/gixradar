+"""Prospective test-before-train circle IoU receipts and rolling match verdicts.
+
+This module never commits, fits, changes original ranking/math, or contacts an
+external service. The collector owns one reserved writer transaction around
+score_match and ingestion, then trains and acknowledges the separate map gate.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from datetime import datetime, timezone
+from math import acos, hypot, isfinite, pi, sqrt
+from pathlib import Path
+from uuid import uuid4
+import json
+import re
+import sqlite3
+import sys
+
+from app.core.errors import AppError
+from app.morse_native.prediction import LLMSettings
+from app.services.analyzer import (VerifiedPredictionService,artifact_reference,
+    fingerprint,native_config)
+from app.services.prediction import PredictionService
+
+POLICY = 'prequential-circle-iou-v1'
+WINDOW_SIZE = 20
+IOU_THRESHOLD = 0.70
+_MODES = ('normal','competitive')
+_HORIZONS = ('next','final')
+
+
+def _check(check):
+    if check is not None:
+        check()
+
+
+def _finite(value):
+    return type(value) in (int,float) and isfinite(value)
+
+
+def circle_iou(x1,y1,r1,x2,y2,r2):
+    """Intersection/union of two positive-area circles; unrounded float result."""
+    if not all(_finite(value) for value in (x1,y1,r1,x2,y2,r2)) or r1<=0 or r2<=0:
+        raise ValueError('Finite centers and positive radii are required')
+    distance = hypot(x1-x2,y1-y2)
+    if distance>=r1+r2:
+        return 0.0
+    if distance<=abs(r1-r2):
+        return (min(r1,r2)/max(r1,r2))**2
+    scale = max(distance,r1,r2)
+    d,a,b = distance/scale,r1/scale,r2/scale
+    first = max(-1.0,min(1.0,(d*d+a*a-b*b)/(2*d*a)))
+    second = max(-1.0,min(1.0,(d*d+b*b-a*a)/(2*d*b)))
+    product = max(0.0,(-d+a+b)*(d+a-b)*(d-a+b)*(d+a+b))
+    intersection = a*a*acos(first)+b*b*acos(second)-.5*sqrt(product)
+    union = pi*(a*a+b*b)-intersection
+    return max(0.0,min(1.0,intersection/union))
+
+
+def iou_success(value):
+    """Strict user rule: exact 0.70 fails. No rounding or tolerance relaxation."""
+    return _finite(value) and value>IOU_THRESHOLD
+
+
+def _timestamp(value,required=False):
+    if value is None and not required:
+        return None
+    try:
+        parsed = datetime.fromisoformat(value.replace('Z','+00:00')) if isinstance(value,str) else None
+        if parsed is None or parsed.tzinfo is None:
+            raise ValueError()
+        return parsed.astimezone(timezone.utc).isoformat()
+    except (ValueError,OverflowError):
+        if required:
+            raise AppError('PREQUENTIAL_TIME_INVALID','Scoring time must be an aware timestamp',503)
+        return None
+
+
+def _transaction(connection):
+    if not connection.in_transaction:
+        raise ValueError('Prequential writes require a caller-owned transaction')
+
+
+def pending_training(connection,map_id=None):
+    query = 'SELECT map_id,ledger_sequence,match_id,created_at FROM main.prequential_training_pending'
+    rows = connection.execute(query+(' WHERE map_id=?' if map_id is not None else '')+' ORDER BY ledger_sequence',
+                              (map_id,) if map_id is not None else ()).fetchall()
+    return [dict(row) for row in rows]
+
+
+def acknowledge_training(connection,map_id,ledger_sequence):
+    """Clear only the exact completed training attempt; caller commits."""
+    _transaction(connection)
+    return connection.execute('DELETE FROM main.prequential_training_pending WHERE map_id=? AND ledger_sequence=?',
+                              (map_id,ledger_sequence)).rowcount==1
+
+
+def _circle(value,size):
+    if not isinstance(value,dict):
+        return None
+    center = value.get('center')
+    x,y = (center.get('x'),center.get('y')) if isinstance(center,dict) else (value.get('center_x'),value.get('center_y'))
+    radius = value.get('radius')
+    if not all(_finite(item) for item in (x,y,radius)) or not 0<=x<=size or not 0<=y<=size or not 0<radius<=size*2:
+        return None
+    return {'center_x':float(x),'center_y':float(y),'radius':float(radius)}
+
+
+def _truth(circles,size):
+    if not isinstance(circles,(list,tuple)):
+        raise AppError('PREQUENTIAL_CIRCLES_INVALID','Circle rows must be a sequence',503)
+    result,seen = {},set()
+    for value in circles:
+        if not isinstance(value,dict) or type(value.get('phase')) is not int or not 1<=value['phase']<=8:
+            raise AppError('PREQUENTIAL_CIRCLES_INVALID','Circle phase is invalid',503)
+        phase = value['phase']
+        if phase in seen:
+            raise AppError('PREQUENTIAL_CIRCLES_INVALID','Duplicate circle phase',503)
+        seen.add(phase)
+        circle = _circle(value,size)
+        if circle is not None:
+            result[phase] = circle
+    return result
+
+
+def _summary(row,status):
+    return {'status':status,'ledger_sequence':row['sequence'],'match_id':row['match_id'],
+        'map_id':row['map_id'],'match_type':row['match_type'],
+        'next_case_count':row['next_case_count'],'next_success':bool(row['next_pass']) if row['next_pass'] is not None else None,
+        'final_case_count':row['final_case_count'],'final_success':bool(row['final_pass']) if row['final_pass'] is not None else None}
+
+
+def _model_snapshot(connection,model_dir,map_id):
+    service = VerifiedPredictionService(connection,native_config(),Path(model_dir)/'morse',
+        LLMSettings(enabled=False,base_url=None,api_key=None,model=None,timeout_seconds=1))
+    loaded = service._load_latest_model(map_id,[])
+    if loaded is None:
+        return {'model_run_id':None,'artifact_sha256':None}
+    reference = artifact_reference(connection,model_dir,loaded.run_id)
+    if reference is None:
+        raise AppError('PREQUENTIAL_MODEL_CHANGED','Prediction model changed during snapshot',503)
+    return {'model_run_id':loaded.run_id,'artifact_sha256':reference[0]['artifact_sha256']}
+
+
+def _predict_all(connection,config,model_dir,map_id,mode,truth,check):
+    """No new-match row is in the source DB; only known current circles enter predict."""
+    service = PredictionService(connection,config,model_dir,prediction_mode=mode)
+    frozen_profiles = deepcopy(service._profiles(map_id,mode))
+    # Freeze the parameters produced by the real service from the old DB once,
+    # rather than reconstructing its stage/calibration/fallback implementation.
+    def profiles(requested_map,requested_mode):
+        if requested_map!=map_id or requested_mode!=mode:
+            raise AppError('PREQUENTIAL_SCOPE_INVALID','Prediction scope changed',503)
+        return deepcopy(frozen_profiles)
+    service._profiles = profiles
+    selected = _model_snapshot(connection,model_dir,map_id)
+    had_view = connection.execute("SELECT 1 FROM temp.sqlite_master WHERE type='view' AND name='model_runs'").fetchone() is not None
+    predictions = {}
+    try:
+        for phase,current in sorted(truth.items()):
+            if phase>=8 or phase+1 not in truth and 8 not in truth:
+                continue
+            _check(check)
+            request = {'map_id':map_id,'match_type':mode,
+                'current_circle_center':{'x':current['center_x'],'y':current['center_y']},
+                'current_radius':current['radius']}
+            response = service.predict(request)
+            if response.get('model_run_id') is not None and response['model_run_id']!=selected['model_run_id']:
+                raise AppError('PREQUENTIAL_MODEL_CHANGED','Serving identity changed during scoring',503)
+            predictions[phase] = {'request':request,'response':response}
+        if _model_snapshot(connection,model_dir,map_id)!=selected:
+            raise AppError('PREQUENTIAL_MODEL_CHANGED','Prediction artifact changed during scoring',503)
+    finally:
+        if not had_view:
+            active_error = sys.exc_info()[0] is not None
+            try:
+                connection.execute('DROP VIEW IF EXISTS temp.model_runs')
+            except sqlite3.Error:
+                if not active_error:
+                    raise
+    native = native_config()
+    frozen = {'model':selected,'mode_profiles':frozen_profiles,
+        'native_configuration_fingerprint':fingerprint({'map':native.get_map(map_id),'zones':native.get_zone_phases(map_id)})}
+    return frozen,predictions
+
+
+def _score_cases(map_id,size,truth,predictions):
+    result = {name:[] for name in _HORIZONS}
+    for phase,current in sorted(truth.items()):
+        if phase>=8:
+            continue
+        response = predictions.get(phase,{}).get('response',{})
+        for name,target_phase in (('next',phase+1),('final',8)):
+            if target_phase not in truth:
+                continue
+            target = truth[target_phase]
+            raw = response.get(name+'_circle')
+            predicted = _circle(raw,size)
+            actual_phase = raw.get('phase') if isinstance(raw,dict) else None
+            value = None
+            if predicted is not None:
+                value = circle_iou(predicted['center_x'],predicted['center_y'],predicted['radius'],
+                                   target['center_x'],target['center_y'],target['radius'])
+            passed = predicted is not None and actual_phase==target_phase and iou_success(value)
+            warnings = response.get('warnings',[])
+            safe_warnings = [value for value in warnings if isinstance(value,str) and re.fullmatch(r'[A-Za-z0-9_:.-]{1,128}',value)]
+            parameters = response.get('circle_parameters')
+            result[name].append({'current_phase':phase,'target_phase':target_phase,'current_circle':current,
+                'actual_circle':target,'predicted_circle':predicted,'predicted_phase':actual_phase if type(actual_phase) is int else None,
+                'iou':value,'success':bool(passed),'missing_prediction':predicted is None,
+                'parameters':{key:parameters[key] for key in ('current_radius','next_radius','final_radius')
+                    if isinstance(parameters,dict) and key in parameters and _finite(parameters[key])},
+                'warnings':safe_warnings})
+    return result
+
+
+def score_match(connection,config,model_dir,match_id,map_id,mode,circles,cancel_check=None,*,game_created_at=None,acquired_at=None):
+    """Write one immutable prospective receipt before ingestion, inside caller TX.
+
+    The caller must use BEGIN IMMEDIATE, then call this before inserting the
+    match or its circles, ingest them in the same transaction and commit. A
+    pending map gate must be trained/acknowledged before another new score.
+    """
+    _transaction(connection)
+    if not isinstance(match_id,str) or re.fullmatch(r'[A-Za-z0-9_.:-]{1,128}',match_id) is None or mode not in _MODES:
+        raise AppError('PREQUENTIAL_SCOPE_INVALID','Match identity or canonical mode is invalid',503)
+    entry = config.get_map(map_id)
+    map_id,size = entry['map_id'],entry['world_size']
+    _check(cancel_check)
+    duplicate = connection.execute('SELECT * FROM main.prequential_matches WHERE policy=? AND match_id=?',
+                                   (POLICY,match_id)).fetchone()
+    if duplicate is not None:
+        return _summary(duplicate,'already_scored')
+    existing = connection.execute('SELECT 1 FROM main.matches WHERE match_id=?',(match_id,)).fetchone() is not None
+    excluded = connection.execute('SELECT 1 FROM main.prequential_exclusions WHERE match_id=?',(match_id,)).fetchone() is not None
+    if existing or excluded:
+        return {'status':'skipped_existing','reason':'existing_match' if existing else 'epoch_excluded',
+            'ledger_sequence':None,'match_id':match_id,'map_id':map_id,'match_type':mode}
+    if pending_training(connection,map_id):
+        raise AppError('PREQUENTIAL_TRAINING_PENDING','The previous new match requires training first',503)
+    epoch = connection.execute('SELECT policy,started_at FROM main.prequential_epoch WHERE id=1').fetchone()
+    if epoch is None or epoch['policy']!=POLICY:
+        raise AppError('PREQUENTIAL_EPOCH_INVALID','The prospective evaluation epoch is unavailable',503)
+    marker = 'prequential_'+uuid4().hex
+    connection.execute('SAVEPOINT '+marker)
+    try:
+        at = _timestamp(acquired_at or datetime.now(timezone.utc).isoformat(),required=True)
+        truth = _truth(circles,size)
+        frozen,predictions = _predict_all(connection,config,model_dir,map_id,mode,truth,cancel_check)
+        cases = _score_cases(map_id,size,truth,predictions)
+        verdicts = {name:all(value['success'] for value in cases[name]) if cases[name] else None for name in _HORIZONS}
+        payload = {'policy':POLICY,'match_id':match_id,'map_id':map_id,'match_type':mode,
+            'game_created_at':_timestamp(game_created_at),'score_acquired_at':at,'epoch_started_at':epoch['started_at'],
+            'iou_threshold':IOU_THRESHOLD,'threshold_comparison':'strict_gt','match_success_rule':'all_evaluable_stages',
+            'frozen_pre_ingest':frozen,'cases':cases,'verdicts':verdicts}
+        _check(cancel_check)
+        selected = frozen['model']
+        cursor = connection.execute('INSERT INTO main.prequential_matches(policy,match_id,map_id,match_type,epoch_started_at,'+
+            'game_created_at,score_acquired_at,model_run_id,model_artifact_sha256,next_case_count,next_pass,final_case_count,'+
+            'final_pass,payload_sha256,payload_json) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',
+            (POLICY,match_id,map_id,mode,epoch['started_at'],payload['game_created_at'],at,selected['model_run_id'],
+             selected['artifact_sha256'],len(cases['next']),int(verdicts['next']) if verdicts['next'] is not None else None,
+             len(cases['final']),int(verdicts['final']) if verdicts['final'] is not None else None,
+             fingerprint(payload),json.dumps(payload,sort_keys=True,separators=(',',':'),allow_nan=False)))
+        sequence = cursor.lastrowid
+        connection.execute('INSERT INTO main.prequential_training_pending(map_id,ledger_sequence,match_id,created_at) VALUES(?,?,?,?)',
+                           (map_id,sequence,match_id,at))
+        _check(cancel_check)
+        connection.execute('RELEASE SAVEPOINT '+marker)
+        row = connection.execute('SELECT * FROM main.prequential_matches WHERE sequence=?',(sequence,)).fetchone()
+        return _summary(row,'scored')
+    except BaseException:
+        try:
+            connection.execute('ROLLBACK TO SAVEPOINT '+marker)
+            connection.execute('RELEASE SAVEPOINT '+marker)
+        except sqlite3.Error:
+            pass
+        raise
+
+
+def rolling_quality(connection,map_id,mode):
+    """Read per-horizon last 20 committed match verdicts, across model runs."""
+    result = {'policy':POLICY,'map_id':map_id,'match_type':mode,'window_size':WINDOW_SIZE,
+        'iou_threshold':IOU_THRESHOLD,'threshold_comparison':'strict_gt','match_success_rule':'all_evaluable_stages',
+        'order_policy':'persisted_arrival_sequence','history_scope':'new_matches_since_epoch','epoch_started_at':None}
+    for name in _HORIZONS:
+        result[name] = {'quality_state':'waiting_new_matches','evaluated_matches':0,'successful_matches':0,'confidence_percent':None}
+    try:
+        epoch = connection.execute('SELECT policy,started_at FROM main.prequential_epoch WHERE id=1').fetchone()
+        if epoch is None or epoch['policy']!=POLICY or mode not in _MODES:
+            return result
+        result['epoch_started_at'] = epoch['started_at']
+        for name in _HORIZONS:
+            rows = connection.execute('SELECT '+name+'_pass AS success FROM main.prequential_matches '+
+                'WHERE policy=? AND map_id=? AND match_type=? AND '+name+'_case_count>0 ORDER BY sequence DESC LIMIT ?',
+                (POLICY,map_id,mode,WINDOW_SIZE)).fetchall()
+            count,success = len(rows),sum(value['success'] for value in rows)
+            result[name] = {'quality_state':'full_window' if count==WINDOW_SIZE else 'partial_window' if count else 'waiting_new_matches',
+                'evaluated_matches':count,'successful_matches':success,'confidence_percent':100.0*success/count if count else None}
+    except sqlite3.Error:
+        pass
+    return result
