diff --git a/app/zones/backend/app/db/migrations/015_prequential_quality.sql b/app/zones/backend/app/db/migrations/015_prequential_quality.sql
new file mode 100644
--- /dev/null
+++ b/app/zones/backend/app/db/migrations/015_prequential_quality.sql
@@ -0,0 +1,49 @@
+-- A new, prospective arrival-order epoch. Never backfill already known games.
+CREATE TABLE IF NOT EXISTS prequential_epoch (
+    id INTEGER PRIMARY KEY CHECK(id=1),
+    policy TEXT NOT NULL,
+    started_at TEXT NOT NULL
+);
+INSERT OR IGNORE INTO prequential_epoch(id,policy,started_at)
+VALUES(1,'prequential-circle-iou-v1',strftime('%Y-%m-%dT%H:%M:%fZ','now'));
+CREATE TABLE IF NOT EXISTS prequential_exclusions (
+    match_id TEXT PRIMARY KEY
+);
+INSERT OR IGNORE INTO prequential_exclusions(match_id) SELECT match_id FROM matches;
+
+CREATE TABLE IF NOT EXISTS prequential_matches (
+    sequence INTEGER PRIMARY KEY AUTOINCREMENT,
+    policy TEXT NOT NULL,
+    match_id TEXT NOT NULL,
+    map_id TEXT NOT NULL,
+    match_type TEXT NOT NULL CHECK(match_type IN ('normal','competitive')),
+    epoch_started_at TEXT NOT NULL,
+    game_created_at TEXT,
+    score_acquired_at TEXT NOT NULL,
+    model_run_id TEXT,
+    model_artifact_sha256 TEXT,
+    next_case_count INTEGER NOT NULL CHECK(next_case_count>=0),
+    next_pass INTEGER CHECK(next_pass IN (0,1)),
+    final_case_count INTEGER NOT NULL CHECK(final_case_count>=0),
+    final_pass INTEGER CHECK(final_pass IN (0,1)),
+    payload_sha256 TEXT NOT NULL,
+    payload_json TEXT NOT NULL,
+    UNIQUE(policy,match_id),
+    CHECK((next_case_count=0 AND next_pass IS NULL) OR (next_case_count>0 AND next_pass IS NOT NULL)),
+    CHECK((final_case_count=0 AND final_pass IS NULL) OR (final_case_count>0 AND final_pass IS NOT NULL)),
+    CHECK((model_run_id IS NULL AND model_artifact_sha256 IS NULL)
+       OR (model_run_id IS NOT NULL AND model_artifact_sha256 IS NOT NULL))
+);
+CREATE INDEX IF NOT EXISTS idx_prequential_window ON prequential_matches(map_id,match_type,policy,sequence);
+CREATE TRIGGER IF NOT EXISTS prequential_matches_no_update BEFORE UPDATE ON prequential_matches
+BEGIN SELECT RAISE(ABORT,'PREQUENTIAL_LEDGER_IMMUTABLE'); END;
+CREATE TRIGGER IF NOT EXISTS prequential_matches_no_delete BEFORE DELETE ON prequential_matches
+BEGIN SELECT RAISE(ABORT,'PREQUENTIAL_LEDGER_IMMUTABLE'); END;
+
+-- Mutable orchestration state is separate from the immutable score receipt.
+CREATE TABLE IF NOT EXISTS prequential_training_pending (
+    map_id TEXT PRIMARY KEY,
+    ledger_sequence INTEGER NOT NULL REFERENCES prequential_matches(sequence),
+    match_id TEXT NOT NULL,
+    created_at TEXT NOT NULL
+);
