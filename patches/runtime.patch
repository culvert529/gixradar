+
+
+@dataclass(frozen=True)
+class PredictionHotspotSummary:
+    phase: int
+    available: bool
+    generated_at: str | None
+    grid_size: int
+    top_tiles: list[HotspotTileSummary]
+    max_hotspot_score: float
